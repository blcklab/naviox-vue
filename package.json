{
  "name": "@blcklab/naviox-vue",
  "version": "0.1.0-alpha.18",
  "description": "Naviox command palette, preview-rich mega-menu and contextual autocomplete, with cinematic themes",
  "type": "module",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/copy-styles.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run build && npm test && npm run docs:check && npm run verify:package",
    "pack:dry": "npm pack --dry-run",
    "demo": "vite --config examples/portfolio/vite.config.ts",
    "verify:deps": "node scripts/verify-real-deps.mjs",
    "demo:build": "vite build --config examples/portfolio/vite.config.ts",
    "demo:navigation": "vite --config examples/navigation/vite.config.ts",
    "demo:navigation:build": "vite build --config examples/navigation/vite.config.ts",
    "verify:package": "node scripts/verify-package.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:ssr": "node tests/ssr-smoke.mjs",
    "release:verify": "npm run verify:deps && npm run check && npm run demo:build && npm run demo:navigation:build && npm run test:ssr && npm run test:e2e",
    "verify:lock": "node scripts/verify-lock.mjs"
  },
  "keywords": [
    "command-palette",
    "vue",
    "cmdk",
    "vue3",
    "headless",
    "command-menu",
    "navigation",
    "anime-inspired",
    "accessible"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@blcklab/naviox": "0.1.0-alpha.7"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vue": "^3.5.0",
    "vite": "^7.0.0",
    "@playwright/test": "^1.55.0",
    "@axe-core/playwright": "^4.10.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blcklab/naviox-vue.git"
  },
  "homepage": "https://github.com/blcklab/naviox-vue#readme",
  "bugs": {
    "url": "https://github.com/blcklab/naviox-vue/issues"
  }
}
